      "events": [
        {
          "disabled": false,
          "folded": false,
          "type": "BuiltinCommonInstructions::Comment",
          "color": {
            "b": 120,
            "g": 180,
            "r": 255,
            "textB": 255,
            "textG": 255,
            "textR": 255
          },
          "comment": "TOP-DOWN EXTRACTION SHOOTER BASE\nWASD = movement | LMB = shoot | Mouse = aim\nCamera follows player. World is 4000 x 3000.",
          "comment2": ""
        },
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const players = runtimeScene.getObjects(\"Player\");",
            "if (players.length === 0) return;",
            "const player = players[0];",
            "const scoreText = runtimeScene.getObjects(\"ScoreText\")[0];",
            "const input = runtimeScene.getGame().getInputManager();",
            "if (scoreText) {",
            "  const camX = gdjs.evtTools.camera.getCameraX(runtimeScene, \"\", 0);",
            "  const camY = gdjs.evtTools.camera.getCameraY(runtimeScene, \"\", 0);",
            "  const camW = gdjs.evtTools.camera.getCameraWidth(runtimeScene, \"\", 0);",
            "  const camH = gdjs.evtTools.camera.getCameraHeight(runtimeScene, \"\", 0);",
            "  scoreText.setPosition(camX - camW / 2 + 20, camY - camH / 2 + 20);",
            "  scoreText.setString(\"PUNKTY: \" + Math.floor(runtimeScene.getVariables().get(\"Score\").getAsNumber()));",
            "}",
            "const dt = runtimeScene.getElapsedTime() / 1000;",
            "const worldW = 4000, worldH = 3000, moveSpeed = 260;",
            "",
            "let dx = 0, dy = 0;",
            "if (input.isKeyPressed(65)) dx -= 1;",
            "if (input.isKeyPressed(68)) dx += 1;",
            "if (input.isKeyPressed(87)) dy -= 1;",
            "if (input.isKeyPressed(83)) dy += 1;",
            "if (dx || dy) {",
            "  const len = Math.sqrt(dx*dx + dy*dy);",
            "  player.setX(player.getX() + dx/len * moveSpeed * dt);",
            "  player.setY(player.getY() + dy/len * moveSpeed * dt);",
            "}",
            "player.setX(Math.max(9, Math.min(worldW-9, player.getX())));",
            "player.setY(Math.max(9, Math.min(worldH-9, player.getY())));",
            "",
            "gdjs.evtTools.camera.centerCamera(runtimeScene, player, true, \"\", 0);",
            "",
            "const baseLayer = runtimeScene.getLayer(\"\");",
            "const mouse = baseLayer.convertCoords(input.getMouseX(), input.getMouseY(), 0, [0,0]);",
            "const angle = Math.atan2(mouse[1]-player.getY(), mouse[0]-player.getX()) * 180 / Math.PI;",
            "player.setAngle(angle);",
            "",
            "let cooldown = runtimeScene.getVariables().get(\"ShootCooldown\").getAsNumber() - dt;",
            "if (cooldown < 0) cooldown = 0;",
            "runtimeScene.getVariables().get(\"ShootCooldown\").setNumber(cooldown);",
            "",
            "if (input.isMouseButtonPressed(0) && cooldown <= 0) {",
            "  runtimeScene.getVariables().get(\"ShootCooldown\").setNumber(0.10);",
            "  const bullet = runtimeScene.createObject(\"Bullet\");",
            "  if (bullet) {",
            "    const r = angle * Math.PI / 180;",
            "    bullet.setPosition(player.getX()+Math.cos(r)*16, player.getY()+Math.sin(r)*16);",
            "    bullet.setAngle(angle);",
            "    bullet.getVariables().get(\"Speed\").setNumber(900);",
            "    bullet.getVariables().get(\"Life\").setNumber(1.5);",
            "  }",
            "}",
            "",
            "for (const enemy of runtimeScene.getObjects(\"Enemy\")) {",
            "  const vx = player.getX()-enemy.getX(), vy = player.getY()-enemy.getY();",
            "  const dist = Math.sqrt(vx*vx+vy*vy);",
            "  if (dist > 30) {",
            "    const speed = enemy.getVariables().get(\"Speed\").getAsNumber();",
            "    enemy.setX(enemy.getX()+vx/dist*speed*dt);",
            "    enemy.setY(enemy.getY()+vy/dist*speed*dt);",
            "  }",
            "}",
            "",
            "for (const bullet of runtimeScene.getObjects(\"Bullet\")) {",
            "  const r = bullet.getAngle() * Math.PI / 180;",
            "  const speed = bullet.getVariables().get(\"Speed\").getAsNumber();",
            "  let life = bullet.getVariables().get(\"Life\").getAsNumber() - dt;",
            "  bullet.setX(bullet.getX()+Math.cos(r)*speed*dt);",
            "  bullet.setY(bullet.getY()+Math.sin(r)*speed*dt);",
            "  bullet.getVariables().get(\"Life\").setNumber(life);",
            "",
            "  let hit = false;",
            "  for (const enemy of runtimeScene.getObjects(\"Enemy\")) {",
            "    const hx = bullet.getX()-enemy.getX(), hy = bullet.getY()-enemy.getY();",
            "    if (hx*hx+hy*hy < 15*15) {",
            "      const hp = enemy.getVariables().get(\"HP\").getAsNumber()-1;",
            "      enemy.getVariables().get(\"HP\").setNumber(hp);",
            "      if (hp <= 0) { runtimeScene.getVariables().get(\"Score\").setNumber(runtimeScene.getVariables().get(\"Score\").getAsNumber() + 100); enemy.deleteFromScene(); }",
            "      hit = true;",
            "      break;",
            "    }",
            "  }",
            "  if (hit || life <= 0 || bullet.getX() < -20 || bullet.getY() < -20 ||",
            "      bullet.getX() > worldW+20 || bullet.getY() > worldH+20) {",
            "    bullet.deleteFromScene();",
            "  }",
            "}"
          ],
