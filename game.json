s":false,"directions":[{"looping":false,"timeBetweenFrames":0.08,"sprites":[{"hasCustomCollisionMask":false,"image":"assets\\enemy.png","points":[],"originPoint":{"name":"origine","x":0,"y":0},"centerPoint":{"automatic":true,"name":"centre","x":0,"y":0},"customCollisionMask":[]}]}]}],"assetStoreId":"","effects":[]},{"name":"ScoreText","smoothed":true,"tags":"","type":"TextObject::Text","underlined":false,"variables":[],"behaviors":[],"string":"PUNKTY: 0","font":"","characterSize":28,"color":{"b":255,"g":255,"r":255}},{"name":"WaveText","smoothed":true,"tags":"","type":"TextObject::Text","underlined":false,"variables":[],"behaviors":[],"string":"FALA: 1","font":"","characterSize":24,"color":{"b":255,"g":255,"r":255}},{"name":"EnemiesText","smoothed":true,"tags":"","type":"TextObject::Text","underlined":false,"variables":[],"behaviors":[],"string":"WROGOWIE: 0","font":"","characterSize":24,"color":{"b":255,"g":255,"r":255}},{"name":"HealthText","smoothed":true,"tags":"","type":"TextObject::Text","underlined":false,"variables":[],"behaviors":[],"string":"HP: 100 / 100","font":"","characterSize":28,"color":{"b":255,"g":255,"r":255}},{"name":"SmallEnemy","tags":"ENEMY","type":"Sprite","updateIfNotVisible":false,"variables":[{"name":"HP","type":"number","value":2},{"name":"Speed","type":"number","value":310},{"name":"InvisibleRange","type":"number","value":300}],"behaviors":[],"animations":[{"name":"","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.08,"sprites":[{"hasCustomCollisionMask":false,"image":"assets\\small_enemy.png","points":[],"originPoint":{"name":"origine","x":0,"y":0},"centerPoint":{"automatic":true,"name":"centre","x":0,"y":0},"customCollisionMask":[]}]}]}],"assetStoreId":"","effects":[]},{"name":"ChargerEnemy","tags":"ENEMY","type":"Sprite","updateIfNotVisible":false,"variables":[{"name":"HP","type":"number","value":8},{"name":"Speed","type":"number","value":235},{"name":"Charging","type":"number","value":0},{"name":"ChargeTimer","type":"number","value":0},{"name":"ChargeCooldown","type":"number","value":1.2},{"name":"ChargeVX","type":"number","value":0},{"name":"ChargeVY","type":"number","value":0}],"behaviors":[],"animations":[{"name":"","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.08,"sprites":[{"hasCustomCollisionMask":false,"image":"assets\\charger_enemy.png","points":[],"originPoint":{"name":"origine","x":0,"y":0},"centerPoint":{"automatic":true,"name":"centre","x":0,"y":0},"customCollisionMask":[]}]}]}],"assetStoreId":"","effects":[]}],"events":[{"disabled":false,"folded":false,"type":"BuiltinCommonInstructions::Comment","color":{"b":120,"g":180,"r":255,"textB":255,"textG":255,"textR":255},"comment":"TOP-DOWN EXTRACTION SHOOTER BASE\nWASD = movement | LMB = shoot | Mouse = aim\nCamera follows player. World is 4000 x 3000.","comment2":""},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const players = runtimeScene.getObjects(\"Player\");","if (players.length === 0) return;","","const player = players[0];","const input = runtimeScene.getGame().getInputManager();","const dt = Math.min(runtimeScene.getElapsedTime() / 1000, 0.05);","const sceneVars = runtimeScene.getVariables();","const worldW = 4000;","const worldH = 3000;","const moveSpeed = 260;","","// PLAYER MOVEMENT","let moveX = 0;","let moveY = 0;","if (input.isKeyPressed(65)) moveX -= 1; // A","if (input.isKeyPressed(68)) moveX += 1; // D","if (input.isKeyPressed(87)) moveY -= 1; // W","if (input.isKeyPressed(83)) moveY += 1; // S","if (moveX !== 0 || moveY !== 0) {","  const length = Math.sqrt(moveX * moveX + moveY * moveY);","  player.setX(player.getX() + (moveX / length) * moveSpeed * dt);","  player.setY(player.getY() + (moveY / length) * moveSpeed * dt);","}","player.setX(Math.max(9, Math.min(worldW - 9, player.getX())));","player.setY(Math.max(9, Math.min(worldH - 9, player.getY())));","","// CAMERA FOLLOWS PLAYER","gdjs.evtTools.camera.centerCamera(runtimeScene, player, true, \"\", 0);","","// AIM TOWARD MOUSE","const baseLayer = runtimeScene.getLayer(\"\");","const mouseCoords = baseLayer.convertCoords(input.getMouseX(), input.getMouseY(), 0, [0, 0]);","const aimAngle = Math.atan2(mouseCoords[1] - player.getY(), mouseCoords[0] - player.getX()) * 180 / Math.PI;","player.setAngle(aimAngle);","","// SHOOTING","let cooldown = sceneVars.get(\"ShootCooldown\").getAsNumber() - dt;","if (cooldown < 0) cooldown = 0;","sceneVars.get(\"ShootCooldown\").setNumber(cooldown);","if (input.isMouseButtonPressed(0) && cooldown <= 0) {","  sceneVars.get(\"ShootCooldown\").setNumber(0.16);","  const bullet = runtimeScene.createObject(\"Bullet\");","  if (bullet) {","    const angleRad = aimAngle * Math.PI / 180;","    bullet.setPosition(","      player.getX() + Math.cos(angleRad) * 16,","      player.getY() + Math.sin(angleRad) * 16","    );","    bullet.setAngle(aimAngle);","    bullet.getVariables().get(\"Speed\").setNumber(900);","    bullet.getVariables().get(\"Life\").setNumber(1.5);","    bullet.getVariables().get(\"Damage\").setNumber(10);","  }","}","","// ENEMY HELPERS: all enemy types share HP and Speed variables.","const enemyNames = [\"Enemy\", \"SmallEnemy\", \"ChargerEnemy\"];","const getAllEnemies = () => enemyNames.flatMap(name => runtimeScene.getObjects(name));","","// WAVE SYSTEM: spawn a mix of standard, stealth and charging enemies.","let wave = sceneVars.get(\"Wave\").getAsNumber();","let total = sceneVars.get(\"WaveTotal\").getAsNumber();","let spawned = sceneVars.get(\"WaveSpawned\").getAsNumber();","let spawnTimer = sceneVars.get(\"WaveSpawnTimer\").getAsNumber() - dt;","let intermission = sceneVars.get(\"WaveIntermission\").getAsNumber();","","if (total <= 0) {","  total = Math.ceil(4 * Math.pow(1.5, wave - 1));","  spawned = 0;","  spawnTimer = 0.4;","  sceneVars.get(\"WaveTotal\").setNumber(total);","  sceneVars.get(\"WaveSpawned\").setNumber(0);","  sceneVars.get(\"SpecialSpawned\").setNumber(0);","}","const aliveBeforeSpawn = getAllEnemies();","if (spawned >= total && aliveBeforeSpawn.length === 0) {","  if (intermission <= 0) intermission = 2.5;","  intermission -= dt;","  if (intermission <= 0) {","    wave += 1;","    total = Math.ceil(4 * Math.pow(1.5, wave - 1));","    spawned = 0;","    spawnTimer = 0.5;","    intermission = 0;","    sceneVars.get(\"Wave\").setNumber(wave);","    sceneVars.get(\"WaveTotal\").setNumber(total);","    sceneVars.get(\"WaveSpawned\").setNumber(0);","  sceneVars.get(\"SpecialSpawned\").setNumber(0);","  }","  sceneVars.get(\"WaveIntermission\").setNumber(intermission);","} else if (spawned < total) {","  if (spawnTimer <= 0) {","    const spawnAngle = Math.random() * Math.PI * 2;","    const spawnRadius = 420 + Math.random() * 160;","    const spawnX = Math.max(24, Math.min(worldW - 24, player.getX() + Math.cos(spawnAngle) * spawnRadius));","    const spawnY = Math.max(24, Math.min(worldH - 24, player.getY() + Math.sin(spawnAngle) * spawnRadius));","    // Special enemies start in wave 3 and are limited per wave.","    const specialLimit = wave < 3 ? 0 : Math.min(Math.ceil(total * 0.12), 1 + Math.floor((wave - 3) / 3));","    const specialsSpawned = sceneVars.get(\"SpecialSpawned\").getAsNumber();","    const shouldForceSpecial = wave >= 3 && specialsSpawned === 0 && spawned >= Math.floor(total / 2);","    const spawnSpecial = specialsSpawned < specialLimit && (shouldForceSpecial || Math.random() < 0.12);","    const enemyName = spawnSpecial ? (Math.random() < 0.5 ? \"SmallEnemy\" : \"ChargerEnemy\") : \"Enemy\";","    const enemy = runtimeScene.createObject(enemyName);","    if (enemy) {","      enemy.setPosition(spawnX, spawnY);","      enemy.getVariables().get(\"EnemyType\").setString(enemyName);","      if (spawnSpecial) sceneVars.get(\"SpecialSpawned\").setNumber(specialsSpawned + 1);","      const baseHP = enemyName === \"SmallEnemy\" ? 20 : (enemyName === \"ChargerEnemy\" ? 80 : 30);","      const baseSpeed = enemyName === \"SmallEnemy\" ? 310 : (enemyName === \"ChargerEnemy\" ? 235 : 80);","      enemy.getVariables().get(\"HP\").setNumber(Math.ceil(baseHP * Math.pow(1.1, wave - 1)));","      enemy.getVariables().get(\"Speed\").setNumber(baseSpeed + (enemyName === \"SmallEnemy\" ? 0 : Math.min(45, (wave - 1) * 3)));","      spawned += 1;","      sceneVars.get(\"WaveSpawned\").setNumber(spawned);","    }","    spawnTimer = Math.max(0.25, 1.0 - wave * 0.04);","  }","  sceneVars.get(\"WaveSpawnTimer\").setNumber(spawnTimer);","}","","// ENEMY AI","for (const enemy of getAllEnemies()) {","  const name = enemy.getVariables().get(\"EnemyType\").getAsString();","  const vx = player.getX() - enemy.getX();","  const vy = player.getY() - enemy.getY();","  const distance = Math.sqrt(vx * vx + vy * vy) || 1;","","  if (name === \"SmallEnemy\") {","    // Stealth runner: invisible at long range, visible within 300 world units.","    enemy.setOpacity(distance > enemy.getVariables().get(\"InvisibleRange\").getAsNumber() ? 0 : 255);","    if (distance > 18) {","      const speed = enemy.getVariables().get(\"Speed\").getAsNumber();","      enemy.setX(enemy.getX() + (vx / distance) * speed * dt);","      enemy.setY(enemy.getY() + (vy / distance) * speed * dt);","    }","  } else if (name === \"ChargerEnemy\") {","    let charging = enemy.getVariables().get(\"Charging\").getAsNumber();","    let chargeTimer = Math.max(0, enemy.getVariables().get(\"ChargeTimer\").getAsNumber() - dt);","    let chargeCooldown = Math.max(0, enemy.getVariables().get(\"ChargeCooldown\").getAsNumber() - dt);","","    // Lock direction once when player is within 520 units; no steering during the dash.","    if (charging <= 0 && chargeCooldown <= 0 && distance < 520) {","      enemy.getVariables().get(\"ChargeVX\").setNumber(vx / distance);","      enemy.getVariables().get(\"ChargeVY\").setNumber(vy / distance);","      charging = 1;","      chargeTimer = 0.65;","    }","    if (charging > 0) {","      const dirX = enemy.getVariables().get(\"ChargeVX\").getAsNumber();","      const dirY = enemy.getVariables().get(\"ChargeVY\").getAsNumber();","      const dashSpeed = 620;","      enemy.setX(enemy.getX() + dirX * dashSpeed * dt);","      enemy.setY(enemy.getY() + dirY * dashSpeed * dt);","      if (chargeTimer <= 0) {","        charging = 0;","        chargeCooldown = 2.2;","      }","    } else if (distance > 30) {","      const speed = enemy.getVariables().get(\"Speed\").getAsNumber();","      enemy.setX(enemy.getX() + (vx / distance) * speed * dt);","      enemy.setY(enemy.getY() + (vy / distance) * speed * dt);","    }","    enemy.getVariables().get(\"Charging\").setNumber(charging);","    enemy.getVariables().get(\"ChargeTimer\").setNumber(chargeTimer);","    enemy.getVariables().get(\"ChargeCooldown\").setNumber(chargeCooldown);","  } else if (distance > 28) {","    const speed = enemy.getVariables().get(\"Speed\").getAsNumber();","    enemy.setX(enemy.getX() + (vx / distance) * speed * dt);","    enemy.setY(enemy.getY() + (vy / distance) * speed * dt);","  }","}","","// PLAYER HEALTH: enemies damage on contact; health regenerates after 4 seconds.","let playerHP = sceneVars.get(\"PlayerHP\").getAsNumber();","const maxPlayerHP = sceneVars.get(\"PlayerMaxHP\").getAsNumber();","let timeSinceDamage = sceneVars.get(\"TimeSinceDamage\").getAsNumber() + dt;","let damageCooldown = Math.max(0, sceneVars.get(\"PlayerDamageCooldown\").getAsNumber() - dt);","","// Enemies stop close to the player. Contact deals 10 damage every 0.8 seconds.","let touchingEnemy = false;","for (const enemy of getAllEnemies()) {","  const dx = player.getX() - enemy.getX();","  const dy = player.getY() - enemy.getY();","  if (dx * dx + dy * dy < 28 * 28) {","    touchingEnemy = true;","    break;","  }","}","if (touchingEnemy && damageCooldown <= 0 && playerHP > 0) {","  playerHP = Math.max(0, playerHP - 10);","  timeSinceDamage = 0;","  damageCooldown = 0.8;","}","","// Regeneration starts slowly 4 seconds after damage, then accelerates over time.","// Starts at 0.5 HP/s, gains 0.5 HP/s each second, and caps at 12 HP/s.","if (timeSinceDamage >= 4 && playerHP > 0) {","  const regenRate = Math.min(12, 0.5 + (timeSinceDamage - 4) * 0.5);","  playerHP = Math.min(maxPlayerHP, playerHP + regenRate * dt);","}","sceneVars.get(\"PlayerHP\").setNumber(playerHP);","sceneVars.get(\"TimeSinceDamage\").setNumber(timeSinceDamage);","sceneVars.get(\"PlayerDamageCooldown\").setNumber(damageCooldown);","","// BULLETS MOVE, DEAL DAMAGE, AND GIVE POINTS ON KILL","for (const bullet of runtimeScene.getObjects(\"Bullet\")) {","  const angleRad = bullet.getAngle() * Math.PI / 180;","  const speed = bullet.getVariables().get(\"Speed\").getAsNumber();","  let life = bullet.getVariables().get(\"Life\").getAsNumber() - dt;","  bullet.setX(bullet.getX() + Math.cos(angleRad) * speed * dt);","  bullet.setY(bullet.getY() + Math.sin(angleRad) * speed * dt);","  bullet.getVariables().get(\"Life\").setNumber(life);","  let hit = false;","  for (const enemy of getAllEnemies()) {","    const hitX = bullet.getX() - enemy.getX();","    const hitY = bullet.getY() - enemy.getY();","    if (hitX * hitX + hitY * hitY < 15 * 15) {","      const damage = bullet.getVariables().get(\"Damage\").getAsNumber();","      const hp = enemy.getVariables().get(\"HP\").getAsNumber() - damage;","      enemy.getVariables().get(\"HP\").setNumber(hp);","      if (hp <= 0) {","        sceneVars.get(\"Score\").setNumber(sceneVars.get(\"Score\").getAsNumber() + 100);","        enemy.deleteFromScene();","      }","      hit = true;","      break;","    }","  }","  if (hit || life <= 0 || bullet.getX() < 0 || bullet.getY() < 0 ||","      bullet.getX() > worldW || bullet.getY() > worldH) {","    bullet.deleteFromScene();","  }","}","","// HUD: pin all four text objects to the top-left of the visible camera.","const camX = gdjs.evtTools.camera.getCameraX(runtimeScene, \"\", 0);","const camY = gdjs.evtTools.camera.getCameraY(runtimeScene, \"\", 0);","const camW = gdjs.evtTools.camera.getCameraWidth(runtimeScene, \"\", 0);","const camH = gdjs.evtTools.camera.getCameraHeight(runtimeScene, \"\", 0);","const hudX = camX - camW / 2 + 20;","const hudY = camY - camH / 2 + 20;","const scoreText = runtimeScene.getObjects(\"ScoreText\")[0];","const waveText = runtimeScene.getObjects(\"WaveText\")[0];","const enemiesText = runtimeScene.getObjects(\"EnemiesText\")[0];","const healthText = runtimeScene.getObjects(\"HealthText\")[0];","","if (scoreText) {","  scoreText.setPosition(hudX, hudY);","  scoreText.setString(\"PUNKTY: \" + Math.floor(sceneVars.get(\"Score\").getAsNumber()));","}","if (waveText) {","  waveText.setPosition(hudX, hudY + 34);","  waveText.setString(\"FALA: \" + Math.floor(sceneVars.get(\"Wave\").getAsNumber()));","}","if (enemiesText) {","  const remaining = getAllEnemies().length +","    Math.max(0, sceneVars.get(\"WaveTotal\").getAsNumber() - sceneVars.get(\"WaveSpawned\").getAsNumber());","  enemiesText.setPosition(hudX, hudY + 68);","  enemiesText.setString(\"WROGOWIE: \" + Math.floor(remaining));","}","if (healthText) {","  healthText.setPosition(hudX, hudY + 102);","  healthText.setString(\"HP: \" + Math.ceil(sceneVars.get(\"PlayerHP\").getAsNumber()) +","    \" / \" + Math.floor(sceneVars.get(\"PlayerMaxHP\").getAsNumber()));","}"],"parameterObjects":"","useStrict":false,"eventsSheetExpanded":true}],"layers":[{"ambientLightColorB":0,"ambientLightColorG":0,"ambientLightColorR":0,"followBaseLayerCamera":false,"isLightingLayer":false,"name":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0,"viewportBottom":1,"viewportLeft":0,"viewportRight":1,"viewportTop":0,"width":0}],"effects":[]}],"behaviorsSharedData":[]}],"externalEvents":[],"eventsFunctionsExtensions":[],"externalLayouts":[],"externalSourceFiles":[]}